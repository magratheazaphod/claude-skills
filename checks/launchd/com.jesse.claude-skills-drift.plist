<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jesse.claude-skills-drift</string>
  <!-- Weekly drift check of the Cowork skills against the installed Claude
       Desktop and the official docs. Opens or updates a GitHub issue on drift.
       A login shell supplies PATH for gh and python3. The Mac is often just
       awake and still offline at this hour, so wait up to 15 minutes for
       GitHub before pulling. This file is the source; launchd runs the copy
       in ~/Library/LaunchAgents. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/projects/claude-skills" &amp;&amp; for i in {1..30}; do curl -fsS -o /dev/null --max-time 5 https://api.github.com &amp;&amp; break; sleep 30; done; git pull -q --ff-only; date; python3 -I checks/drift.py --issue</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/Siwen/Library/Logs/claude-skills-drift.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Siwen/Library/Logs/claude-skills-drift.log</string>
</dict>
</plist>
